# Copy to .env for local development (npm run dev:backend reads it).
# On Render, add the same names under Environment instead.
# Values that still look like placeholders ("your-...", "<...>") are treated as empty.

# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/commitments

# Public https address of the app (used in Teams/email button links), no trailing slash
PUBLIC_URL=http://localhost:3000

# --- Slack (api.slack.com/apps → your app) ---
# OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret
# Your Slack member ID (profile → ⋯ → Copy member ID); everyone's demo messages go here. Can also be set in Settings.
DEMO_SLACK_USER_ID=your-slack-member-id

# --- Microsoft Teams (channel → ⋯ → Workflows → "Post to a channel when a webhook request is received") ---
TEAMS_WEBHOOK_URL=your-teams-workflow-webhook-url

# --- Email: Resend (used first when set) ---
# resend.com → API Keys. Without a verified domain, use onboarding@resend.dev as sender; it then only
# delivers to the address you signed up to Resend with.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Email over SMTP (fallback, or instead of Resend) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = a 16-letter App Password (Google Account → Security → App passwords)
# Outlook / Microsoft 365: smtp.office365.com, port 587
# Your domain's mail (Hostinger, Zoho, GoDaddy…): the SMTP host and port your provider shows
SMTP_HOST=your-smtp-host
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-smtp-password-or-app-password
# Optional; defaults to "Fireflies Commitments <SMTP_USER>"
EMAIL_FROM=
# smtp = try SMTP first (Resend only as fallback). Leave empty to try Resend first.
EMAIL_PROVIDER=smtp
# Inbox that receives everyone's demo emails and the Friday report. Can also be set in Settings.
DEMO_EMAIL=your-inbox@yourdomain.com

# --- Jira Cloud ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-login-email
# id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token
# The letters before your issue numbers, e.g. KAN
JIRA_PROJECT_KEY=your-project-key
# Optional fixed secret for the Jira webhook URL (otherwise one is generated and shown in Settings)
JIRA_WEBHOOK_SECRET=

# Hourly reminders + Friday report on the real clock (the "Next morning 9:30" button works regardless)
ENABLE_SCHEDULER=true
